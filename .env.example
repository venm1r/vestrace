# Required secret. Supply through the environment or a secret manager.
VESTRACE_DATABASE__URL=
VESTRACE_INSTALLATION_FINGERPRINT_VAULT_ROOT=

# Optional non-secret overrides (safe defaults shown).
VESTRACE_DATABASE__MAX_CONNECTIONS=10
VESTRACE_HTTP__BIND=127.0.0.1:3000
VESTRACE_OBSERVABILITY__LOG_FILTER=info
VESTRACE_OBSERVABILITY__FORMAT=text

# Required by server and MCP retrieval. Narrow these values for production.
VESTRACE_POLICY__DATA__MEMORY_LABELS=public,internal,confidential,restricted
VESTRACE_POLICY__DATA__RETRIEVAL__ADMISSIBLE_LABELS=public,internal,confidential,restricted
VESTRACE_POLICY__DATA__RETRIEVAL__ALLOW_UNCLASSIFIED=true
