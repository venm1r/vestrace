        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "format": {
          "type": "string",
          "enum": [
            "markdown",
            "text"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "classification": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "importance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
