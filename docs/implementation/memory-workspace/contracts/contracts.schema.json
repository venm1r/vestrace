{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vestrace:memory-workspace:contracts:0.1",
  "title": "Proposed Memory Workspace contracts",
  "description": "Documentation only. Structural schema does not enforce authorization, UTF-8 byte limits, reference integrity or transactions.",
  "$comment": "Validated alongside executable semantic examples; not a production validator.",
  "$defs": {
    "SourceRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "event",
            "source_revision",
            "legacy_memory_source"
          ]
        },
        "reference_id": {
          "type": "string",
          "format": "uuid"
        },
        "attribution": {
          "type": "string",
          "enum": [
            "exact",
            "legacy_unattributed",
            "imported_annotation"
          ]
        }
      },
      "required": [
        "kind",
        "reference_id",
        "attribution"
      ],
      "additionalProperties": false
    },
    "Revision": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "memory_id": {
          "type": "string",
          "format": "uuid"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "classification": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "importance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_from": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "change_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "provenance_status": {
          "type": "string",
          "enum": [
            "exact",
            "partial",
            "legacy_unattributed",
            "imported"
          ]
        }
      },
      "required": [
        "id",
        "memory_id",
        "number",
        "content",
        "classification",
        "confidence",
        "importance",
        "created_at",
        "valid_from",
        "valid_until",
        "change_reason",
        "sources",
        "provenance_status"
      ],
      "additionalProperties": false
    },
    "MemoryKind": {
      "type": "string",
      "enum": [
        "fact",
        "preference",
        "constraint",
        "decision",
        "task",
        "procedure",
        "observation",
        "outcome",
        "summary"
      ]
    },
    "MemoryStatus": {
      "type": "string",
      "enum": [
        "candidate",
        "active",
        "superseded",
        "rejected",
        "expired",
        "deleted"
      ]
    },
    "MemoryDetail": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "$ref": "#/$defs/MemoryKind"
        },
        "status": {
          "$ref": "#/$defs/MemoryStatus"
        },
        "state_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "active_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "can_correct": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "state_revision",
        "active_revision",
        "can_correct"
      ],
      "additionalProperties": false
    },
    "MemoryListItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "$ref": "#/$defs/MemoryKind"
        },
        "status": {
          "$ref": "#/$defs/MemoryStatus"
        },
        "state_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "revision_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision_number": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "excerpt": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "classification": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "state_revision",
        "revision_id",
        "revision_number",
        "excerpt",
        "classification",
        "created_at"
      ],
      "additionalProperties": false
    },
    "MemoryPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemoryListItem"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "RevisionPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Revision"
          },
          "minItems": 0,
          "maxItems": 50
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "CorrectionRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "replace"
            },
            "expected_revision_id": {
              "type": "string",
              "format": "uuid"
            },
            "expected_state_revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            }
          },
          "required": [
            "action",
            "expected_revision_id",
            "expected_state_revision",
            "reason",
            "content"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "restore"
            },
            "expected_revision_id": {
              "type": "string",
              "format": "uuid"
            },
            "expected_state_revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "restore_from_revision_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "action",
            "expected_revision_id",
            "expected_state_revision",
            "reason",
            "restore_from_revision_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "MutationReceipt": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "memory_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision_id": {
          "type": "string",
          "format": "uuid"
        },
        "state_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "audit_event_id": {
          "type": "string",
          "format": "uuid"
        },
        "applied_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "operation_id",
        "memory_id",
        "revision_id",
        "state_revision",
        "audit_event_id",
        "applied_at"
      ],
      "additionalProperties": false
    },
    "Destination": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "operator"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "model"
            },
            "connection_revision_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "connection_revision_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ContextRequest": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "intent": {
          "type": "string",
          "enum": [
            "current_state",
            "decision_recall",
            "timeline",
            "task_resume",
            "procedure_lookup",
            "user_preferences",
            "semantic_recall"
          ]
        },
        "time_perspective": {
          "type": "string",
          "enum": [
            "current",
            "as_of",
            "timeline",
            "all_history"
          ]
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "max_utf8_bytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 65536
        },
        "token_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "tokenizer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "destination": {
          "$ref": "#/$defs/Destination"
        }
      },
      "required": [
        "query",
        "intent",
        "time_perspective",
        "max_utf8_bytes",
        "destination"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "token_budget": [
          "tokenizer_id"
        ],
        "tokenizer_id": [
          "token_budget"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "time_perspective": {
                "const": "as_of"
              }
            },
            "required": [
              "time_perspective"
            ]
          },
          "then": {
            "required": [
              "as_of"
            ]
          },
          "else": {
            "not": {
              "required": [
                "as_of"
              ]
            }
          }
        }
      ]
    },
    "ContextItem": {
      "type": "object",
      "properties": {
        "memory_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision_id": {
          "type": "string",
          "format": "uuid"
        },
        "representation": {
          "type": "string",
          "enum": [
            "full",
            "summary",
            "atomic",
            "reference"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "inclusion_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "memory_id",
        "revision_id",
        "representation",
        "text",
        "sources",
        "inclusion_reason"
      ],
      "additionalProperties": false
    },
    "ContextSection": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextItem"
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "label",
        "items"
      ],
      "additionalProperties": false
    },
    "ContextResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "rendered_context": {
          "type": "string",
          "minLength": 0,
          "maxLength": 65536
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextSection"
          },
          "minItems": 0,
          "maxItems": 16
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "memory_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "degraded": {
          "type": "boolean"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 32
        },
        "budget": {
          "type": "object",
          "properties": {
            "max_utf8_bytes": {
              "type": "integer",
              "minimum": 256,
              "maximum": 65536
            },
            "used_utf8_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            },
            "estimated_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "estimator": {
              "const": "utf8_div4_estimate"
            },
            "token_budget_enforced": {
              "type": "boolean"
            },
            "tokenizer_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ]
            },
            "used_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "max_utf8_bytes",
            "used_utf8_bytes",
            "estimated_tokens",
            "estimator",
            "token_budget_enforced",
            "tokenizer_id",
            "used_tokens"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "rendered_context",
        "sections",
        "policy_version",
        "memory_epoch",
        "degraded",
        "warnings",
        "budget"
      ],
      "additionalProperties": false
    },
    "CreateCollectionRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "name",
        "reason"
      ],
      "additionalProperties": false
    },
    "Collection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "created_at"
      ],
      "additionalProperties": false
    },
    "CollectionPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Collection"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "SourceHeader": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "external_id": {
          "type": "string",
          "format": "uuid"
        },
        "collection_id": {
          "type": "string",
          "format": "uuid"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "state": {
          "type": "string",
          "enum": [
            "present",
            "missing",
            "retired"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "current_revision_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_memory_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "manual_override": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "external_id",
        "collection_id",
        "relative_path",
        "state",
        "version",
        "current_revision_id",
        "effective_memory_id",
        "manual_override"
      ],
      "additionalProperties": false
    },
    "SourcePage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceHeader"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "SourceRevision": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "source_id": {
          "type": "string",
          "format": "uuid"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "format": {
          "type": "string",
          "enum": [
            "markdown",
            "text"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "classification": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "capture_event_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "id",
        "source_id",
        "number",
        "format",
        "content",
        "classification",
        "recorded_at",
        "capture_event_id"
      ],
